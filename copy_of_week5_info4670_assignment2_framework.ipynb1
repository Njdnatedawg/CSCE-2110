        "impossible_ages = sorted(\n",
        "    students.loc[\n",
        "        (students[\"age\"] < 0) | (students[\"age\"] > 120),\n",
        "        \"age\"\n",
        "    ].unique()\n",
        ")\n",
        "n_neg_work = (students[\"work_hours_per_week\"] < 0).sum()"
